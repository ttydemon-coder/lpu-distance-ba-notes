# LPU Distance B.A. Notes Portal - Environment Variables
# Copy this file to .env.local if you wish to bake credentials into build,
# or configure them dynamically in the in-app "Cloud Settings" modal!

# Supabase Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backblaze B2 S3 Storage
VITE_B2_BUCKET=lpu-notes-bucket
VITE_B2_ENDPOINT=s3.us-west-004.backblazeb2.com
VITE_B2_KEY_ID=004xxxxxxxxxxxxxxxxxx
VITE_B2_APP_KEY=K004xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_B2_REGION=us-west-004
VITE_B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket
